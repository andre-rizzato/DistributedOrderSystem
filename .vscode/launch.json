                "ASPNETCORE_HTTPS_PORT": ""
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            }
        }
    ],
    "compounds": [
        {
            "name": "Start All Microservices",
            "configurations": [
                "OrderService",
                "InventoryService",
                "NotificationService",
                "PaymentService",
                "ProductService",
                "ChatbotService",
                "GatewayBff"
            ]
        },
        {
            "name": "Start All (Backend + Frontend)",
            "configurations": [
                "OrderService",
                "InventoryService", 
                "NotificationService",
                "PaymentService",
                "ProductService",
                "ChatbotService",
                "GatewayBff",
                "Frontend (Angular)",
                "CustomerWebsite"
            ],
            "stopAll": true
        }
    ]
}