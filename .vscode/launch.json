        {
            "name": "Frontend (Angular)",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm start",
            "cwd": "${workspaceFolder}/src/frontend/distributed-order-app",
            "preLaunchTask": "npm: install - frontend",
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "Local:.*(http://\\S+)",
                "uriFormat": "%s"
            }
        },
        {
            "name": "CustomerWebsite",
            "type": "coreclr",
