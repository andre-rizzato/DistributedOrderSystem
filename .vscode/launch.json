{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "OrderService",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/src/OrderService/bin/Debug/net9.0/OrderService.dll",
            "console": "integratedTerminal",
            "preLaunchTask": "build OrderService",
            "cwd": "${workspaceFolder}/src/OrderService"

        },
        {
            "name": "InventoryService",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/src/InventoryService/bin/Debug/net9.0/InventoryService.dll",
            "console": "integratedTerminal",
            "preLaunchTask": "build InventoryService",
            "cwd": "${workspaceFolder}/src/InventoryService"

        },
         {
             "name": "NotificationService",
             "type": "coreclr",
             "request": "launch",
             "program": "${workspaceFolder}/src/NotificationService/bin/Debug/net9.0/NotificationService.dll",
             "console": "integratedTerminal",
             "preLaunchTask": "build NotificationService",
             "cwd": "${workspaceFolder}/src/NotificationService"

        }
        ,
         {
            "name": "GatewayBff",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/src/GatewayBff/bin/Debug/net9.0/GatewayBff.dll",
            "console": "integratedTerminal",
            "preLaunchTask": "build GatewayBff",
            "cwd": "${workspaceFolder}/src/GatewayBff"
        }, 
         {
            "name": "PaymentService",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/src/PaymentService/bin/Debug/net9.0/PaymentService.dll",
            "console": "integratedTerminal",
            "preLaunchTask": "build PaymentService",
            "cwd": "${workspaceFolder}/src/PaymentService"
        },   {
            "name": "ProductService",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/src/ProductService/bin/Debug/net9.0/ProductService.dll",
            "console": "integratedTerminal",
            "preLaunchTask": "build ProductService",
            "cwd": "${workspaceFolder}/src/ProductService"
        },
        {
            "name": "Frontend (Angular)",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm start",
            "cwd": "${workspaceFolder}/frontend/distributed-order-app",
            "preLaunchTask": "npm: install - frontend"
        }
    ],
    "compounds": [
        {
            "name": "Start All Microservices",
            "configurations": [
                "OrderService",
                "InventoryService",
                "NotificationService",
                "PaymentService",
                "ProductService",
                "GatewayBff"
            ]
        },
        {
            "name": "Start All (Backend + Frontend)",
            "configurations": [
                "OrderService",
                "InventoryService",
                "NotificationService",
                "PaymentService",
                "ProductService",
                "GatewayBff",
                "Frontend (Angular)"
            ],
            "stopAll": true
        }
    ]
}