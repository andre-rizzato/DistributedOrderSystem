{
	"version": "2.0.0",
	"// Configurazione delle attività di build, test e deploy": "",
	"// Utilizzabile tramite Ctrl+Shift+P -> Tasks: Run Task": "",
	"tasks": [
		{
			"label": "build OrderService",
			"command": "dotnet",
			"type": "process",
			"args": [
				"build",
				"${workspaceFolder}/src/OrderService/OrderService.csproj",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary"
			],
			"problemMatcher": "$msCompile"
		},
		{
			"label": "build PaymentService",
			"command": "dotnet",
			"type": "process",
			"args": [
				"build",
				"${workspaceFolder}/src/PaymentService/PaymentService.csproj",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary"
			],
			"problemMatcher": "$msCompile"
		},
		{
			"label": "build InventoryService",
			"command": "dotnet",
			"type": "process",
			"args": [
				"build",
				"${workspaceFolder}/src/InventoryService/InventoryService.csproj",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary"
			],
			"problemMatcher": "$msCompile"
		},
		{
			"label": "build NotificationService",
			"command": "dotnet",
			"type": "process",
			"args": [
				"build",
				"${workspaceFolder}/src/NotificationService/NotificationService.csproj",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary"
			],
			"problemMatcher": "$msCompile"
		},
		{
			"label": "build ProductService",
			"command": "dotnet",
			"type": "process",
			"args": [
				"build",
				"${workspaceFolder}/src/ProductService/ProductService.csproj",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary"
			],
			"problemMatcher": "$msCompile"
		},
		{
			"label": "build CustomerWebsite",
			"command": "dotnet",
			"type": "process",
			"args": [
				"build",
				"${workspaceFolder}/frontend/customer-facing e-commerce/CustomerWebsite/CustomerWebsite.csproj",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary"
			],
			"problemMatcher": "$msCompile"
		},
		{
			"label": "build GatewayBff",
			"command": "dotnet",
			"type": "process",
			"args": [
				"build",
				"${workspaceFolder}/src/GatewayBff/GatewayBff.csproj",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary"
			],
			"problemMatcher": "$msCompile"
		},
		{
			"label": "npm: install - frontend",
			"type": "npm",
			"script": "install",
			"path": "frontend/distributed-order-app/",
			"problemMatcher": [],
			"detail": "Install frontend dependencies"
		},
		{
			"label": "npm: start - frontend",
			"type": "npm",
			"script": "start",
			"path": "frontend/distributed-order-app/",
			"problemMatcher": [],
			"isBackground": true,
			"presentation": {
				"reveal": "always",
				"panel": "new"
			}
		},
		{
			"label": "build ChatbotService",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"build",
				"${workspaceFolder}/src/ChatbotService/ChatbotService.csproj",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary"
			],
			"problemMatcher": [
				"$msCompile"
			],
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": false
			},
			"options": {
				"cwd": "${workspaceFolder}/src/ChatbotService"
			}
		},
		{
			"label": "run ChatbotService",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"run",
				"--project",
				"${workspaceFolder}/src/ChatbotService/ChatbotService.csproj"
			],
			"group": "test",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": true,
				"panel": "dedicated",
				"showReuseMessage": false
			},
			"isBackground": true,
			"problemMatcher": [
				{
					"pattern": [
						{
							"regexp": "\\bNow listening on:\\s+(https?://\\S+)",
							"file": 1,
							"location": 2,
							"message": 3
						}
					],
					"background": {
						"activeOnStart": true,
						"beginsPattern": "^.*Now listening on.*",
						"endsPattern": "^.*Application started\\. Press Ctrl\\+C to shut down\\.$"
					}
				}
			],
			"dependsOn": "build ChatbotService"
		},
		{
			"label": "watch ChatbotService",
			"type": "shell", 
			"command": "dotnet",
			"args": [
				"watch",
				"--project",
				"${workspaceFolder}/src/ChatbotService/ChatbotService.csproj"
			],
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": true,
				"panel": "dedicated"
			},
			"isBackground": true,
			"options": {
				"cwd": "${workspaceFolder}/src/ChatbotService"
			},
			"problemMatcher": [
				"$msCompile"
			]
		},
		{
			"label": "test ChatbotService",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"test",
				"${workspaceFolder}/src/ChatbotService"
			],
			"group": "test",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared"
			}
		}
	]
}