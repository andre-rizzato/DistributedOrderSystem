# Secrets consumed by docker-compose.yml (via ${VAR} substitution).
# Copy this file to docker/.env (git-ignored) and replace the values
# before running: docker compose -f docker/docker-compose.yml up -d

# UserService
JWT_SECRET=change-this-to-a-strong-random-secret-at-least-32-chars
ENCRYPTION_KEY=change-this-32-character-key!!!!
ENCRYPTION_IV=change-this-16ch

# ChatbotService
CHATBOT_AUTH_SECRET=change-this-to-a-strong-random-secret-at-least-32-chars
