# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

GATEWAY_BFF_URL=http://localhost:5189

# Order History RAG
ORDER_HISTORY_RAG_ENABLED=false
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Pluggable backends (see connectors/README.md)
ORDER_BACKEND=rest
SCHEDULING_BACKEND=
CATALOG_BACKEND=rest
CHECKOUT_PROCESSOR=

# Azure Key Vault (optional; when enabled, secrets are read from the vault)
KEY_VAULT_ENABLED=false
KEY_VAULT_NAME=
