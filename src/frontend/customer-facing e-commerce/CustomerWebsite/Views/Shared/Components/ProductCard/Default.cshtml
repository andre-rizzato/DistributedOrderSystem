@model CustomerWebsite.Models.ProductDisplayModel

@* ViewComponent per la card prodotto - Rendering ottimizzato e riutilizzabile *@
<div class="col-lg-3 col-md-6">
    <div class="product-card">
        <div class="position-relative">
            @* Immagine prodotto con fallback a placeholder *@
            <img src="@(Model.Images?.FirstOrDefault(i => i.IsPrimary)?.Url ?? $"https://via.placeholder.com/250x250/f8f9fa/333333?text={Uri.EscapeDataString(Model.Name)}")" 
                 alt="@Model.Name" 
                 class="product-image" />
            
            @* Badge sconto se presente *@
            @if (Model.DiscountPercentage > 0)
            {
                <span class="deal-badge">-@Model.DiscountPercentage%</span>
            }
            
            @* Badge Bestseller se applicabile *@
            @if (Model.IsBestseller)
            {
                <span class="badge badge-primary position-absolute top-0 start-0 m-2">
                    <i class="fas fa-star"></i> Bestseller
                </span>
            }
        </div>
        
        <div class="p-3">
            @* Titolo prodotto con link alla pagina dettaglio *@
            <h6 class="product-title">
                <a href="/Product/Details/@Model.ProductId" class="text-decoration-none text-dark">
                    @Model.Name
                </a>
            </h6>
            
            @* Rating stelle prodotto *@
            <div class="stars mb-2">
                @for (int i = 1; i <= 5; i++)
                {
                    @if (i <= Math.Floor(Model.AverageRating))
                    {
                        <i class="fas fa-star"></i>
                    }
                    else if (i - 0.5 <= Model.AverageRating)
                    {
                        <i class="fas fa-star-half-alt"></i>
                    }
                    else
                    {
                        <i class="far fa-star"></i>
                    }
                }
                <small class="text-muted ms-2">(@Model.ReviewCount.ToString("N0"))</small>
            </div>
            
            @* Prezzo prodotto con eventuale sconto *@
            <div class="mb-3">
                @if (Model.DiscountPrice.HasValue)
                {
                    <span class="original-price">€@Model.Price.ToString("N2")</span>
                    <span class="product-price">€@Model.FinalPrice.ToString("N2")</span>
                }
                else
                {
                    <span class="product-price">€@Model.Price.ToString("N2")</span>
                }
            </div>
            
            @* Indicatore disponibilità *@
            @if (!Model.IsInStock)
            {
                <p class="text-danger small mb-2">
                    <i class="fas fa-exclamation-circle"></i> Non disponibile
                </p>
            }
            else if (Model.QuantityAvailable <= 5)
            {
                <p class="text-warning small mb-2">
                    <i class="fas fa-info-circle"></i> Solo @Model.QuantityAvailable rimasti!
                </p>
            }
            
            @* Pulsante aggiungi al carrello *@
            <button class="btn btn-shopverse btn-sm w-100" 
                    onclick="addToCart('@Model.ProductId', 1)"
                    @(!Model.IsInStock ? "disabled" : "")>
                <i class="fas fa-shopping-cart"></i> 
                @(Model.IsInStock ? "Aggiungi al carrello" : "Non disponibile")
            </button>
            
            @* Badge aggiuntivi *@
            <div class="mt-2">
                @if (Model.FreeShipping)
                {
                    <span class="badge bg-success me-1">
                        <i class="fas fa-truck"></i> Spedizione gratuita
                    </span>
                }
                @if (Model.IsPrimeEligible)
                {
                    <span class="badge bg-info">
                        <i class="fas fa-bolt"></i> Prime
                    </span>
                }
            </div>
        </div>
    </div>
</div>
