@inject IConfiguration Configuration
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Main title of the ShopVerse site - modern e-commerce platform -->
    <title>@ViewData["Title"] - ShopVerse</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- Custom ShopVerse CSS with modern design and a unique color palette -->
    <link rel="stylesheet" href="~/css/shopverse.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CustomerWebsite.styles.css" asp-append-version="true" />
    <!-- FontAwesome for modern, eye-catching icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico">
</head>
<body>
    <!-- Main site header with navigation and ShopVerse branding -->
    <header class="shopverse-header">
        <nav class="navbar navbar-expand-sm navbar-dark">
            <div class="container-fluid">
                <!-- ShopVerse logo - the e-commerce platform's main brand -->
                <a class="navbar-brand shopverse-logo" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-shopping-bag me-2"></i>
                    <span class="logo-text">ShopVerse</span>
                </a>

                <!-- Location -->
                <div class="location-section d-none d-md-flex text-white">
                    <i class="fas fa-map-marker-alt"></i>
                    <div class="location-text ms-1">
                        <small>Deliver to</small><br>
                        <strong>Italy</strong>
                    </div>
                </div>

                <!-- Search Bar -->
                <div class="search-section flex-grow-1 mx-3">
                    <form asp-controller="Home" asp-action="Search" method="get" class="search-form d-flex">
                        <select name="Category" class="search-category d-none d-md-block">
                            <option value="">All</option>
                            <option value="electronics">Electronics</option>
                            <option value="books">Books</option>
                            <option value="clothing">Clothing</option>
                            <option value="home">Home & Kitchen</option>
                            <option value="sports">Sports</option>
                        </select>
                        <input type="text" name="SearchTerm" class="search-input form-control"
                               placeholder="Search ShopVerse" />
                        <button type="submit" class="search-btn btn btn-warning">
                            <i class="fas fa-search"></i>
                        </button>
                    </form>
                </div>

                <!-- Right side menu -->
                <div class="navbar-nav d-flex flex-row">
                    <!-- Language -->
                    <div class="nav-item dropdown d-none d-md-flex">
                        <a class="nav-link dropdown-toggle text-white" href="#" data-bs-toggle="dropdown">
                            🇬🇧 EN
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#">🇬🇧 English</a></li>
                            <li><a class="dropdown-item" href="#">🇮🇹 Italiano</a></li>
                        </ul>
                    </div>

                    <!-- Account -->
                    <div class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle text-white" href="#" data-bs-toggle="dropdown">
                            <div class="account-text">
                                <small>Hi, sign in</small><br>
                                <strong>Account & Lists</strong>
                            </div>
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#"><i class="fas fa-user"></i> My Account</a></li>
                            <li><a class="dropdown-item" href="#"><i class="fas fa-box"></i> My Orders</a></li>
                            <li><a class="dropdown-item" href="#"><i class="fas fa-heart"></i> Wish List</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="#"><i class="fas fa-sign-in-alt"></i> Sign In</a></li>
                            <li><a class="dropdown-item" href="#"><i class="fas fa-user-plus"></i> Register</a></li>
                        </ul>
                    </div>

                    <!-- Orders -->
                    <a class="nav-link d-none d-lg-flex text-white text-decoration-none" href="#">
                        <div class="account-text">
                            <small>Returns &</small><br>
                            <strong>Orders</strong>
                        </div>
                    </a>

                    <!-- Cart -->
                    <a class="nav-link cart-link text-white text-decoration-none" asp-controller="Cart" asp-action="Index">
                        <div class="cart-container">
                            <i class="fas fa-shopping-cart"></i>
                            <span class="cart-count" style="display: @(ViewBag.CartItemCount > 0 ? "inline" : "none")">
                                @(ViewBag.CartItemCount ?? 0)
                            </span>
                        </div>
                        <span class="cart-text d-none d-md-inline">Cart</span>
                    </a>
                </div>
            </div>
        </nav>

        <!-- Sub Navigation -->
        <nav class="sub-navbar bg-dark">
            <div class="container-fluid">
                <ul class="nav">
                    <li class="nav-item">
                        <a class="nav-link text-white" href="#" data-bs-toggle="offcanvas" data-bs-target="#categoriesMenu">
                            <i class="fas fa-bars"></i> All
                        </a>
                    </li>
                    <li class="nav-item"><a class="nav-link text-white" href="#">Today's Deals</a></li>
                    <li class="nav-item"><a class="nav-link text-white" href="#">Customer Service</a></li>
                    <li class="nav-item"><a class="nav-link text-white" href="#">Register</a></li>
                    <li class="nav-item"><a class="nav-link text-white" href="#">Wish List</a></li>
                    <li class="nav-item"><a class="nav-link text-white" href="#">Sell</a></li>
                </ul>
            </div>
        </nav>
    </header>

    <!-- Categories Sidebar -->
    <div class="offcanvas offcanvas-start" tabindex="-1" id="categoriesMenu">
        <div class="offcanvas-header bg-dark text-white">
            <h5 class="offcanvas-title"><i class="fas fa-user"></i> Hi, sign in</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body p-0">
            <div class="categories-menu">
                <div class="menu-section p-3">
                    <h6 class="menu-title">Shop by Category</h6>
                    <ul class="menu-list list-unstyled">
                        <li><a href="#" class="menu-link text-decoration-none">Electronics <i class="fas fa-chevron-right float-end"></i></a></li>
                        <li><a href="#" class="menu-link text-decoration-none">Computers <i class="fas fa-chevron-right float-end"></i></a></li>
                        <li><a href="#" class="menu-link text-decoration-none">Home & Kitchen <i class="fas fa-chevron-right float-end"></i></a></li>
                        <li><a href="#" class="menu-link text-decoration-none">Clothing <i class="fas fa-chevron-right float-end"></i></a></li>
                        <li><a href="#" class="menu-link text-decoration-none">Books <i class="fas fa-chevron-right float-end"></i></a></li>
                        <li><a href="#" class="menu-link text-decoration-none">Sports & Leisure <i class="fas fa-chevron-right float-end"></i></a></li>
                        <li><a href="#" class="menu-link text-decoration-none">Beauty <i class="fas fa-chevron-right float-end"></i></a></li>
                        <li><a href="#" class="menu-link text-decoration-none">Auto & Motorcycle <i class="fas fa-chevron-right float-end"></i></a></li>
                    </ul>
                </div>
                <hr>
                <div class="menu-section p-3">
                    <h6 class="menu-title">Programs & Features</h6>
                    <ul class="menu-list list-unstyled">
                        <li><a href="#" class="menu-link text-decoration-none">ShopVerse Plus</a></li>
                        <li><a href="#" class="menu-link text-decoration-none">ShopVerse Business</a></li>
                        <li><a href="#" class="menu-link text-decoration-none">ShopVerse App</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="container-fluid p-0">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Main ShopVerse footer with modern design and complete information -->
    <footer class="shopverse-footer mt-5">
        <div class="footer-top text-center py-3 bg-light">
            <a href="#top" class="back-to-top text-decoration-none">Back to top</a>
        </div>

        <div class="footer-main bg-dark text-white py-4">
            <div class="container">
                <div class="row">
                    <div class="col-md-3 col-sm-6 mb-3">
                        <h6>Get to Know Us</h6>
                        <ul class="footer-links list-unstyled">
                            <li><a href="#" class="text-light text-decoration-none">Careers</a></li>
                            <li><a href="#" class="text-light text-decoration-none">ShopVerse Blog</a></li>
                            <li><a href="#" class="text-light text-decoration-none">About Us</a></li>
                            <li><a href="#" class="text-light text-decoration-none">Investor Relations</a></li>
                        </ul>
                    </div>
                    <div class="col-md-3 col-sm-6 mb-3">
                        <h6>Make Money with ShopVerse</h6>
                        <ul class="footer-links list-unstyled">
                            <li><a href="#" class="text-light text-decoration-none">Sell on ShopVerse</a></li>
                            <li><a href="#" class="text-light text-decoration-none">Sell under ShopVerse Business</a></li>
                            <li><a href="#" class="text-light text-decoration-none">Associates</a></li>
                            <li><a href="#" class="text-light text-decoration-none">Become a Delivery Driver</a></li>
                        </ul>
                    </div>
                    <div class="col-md-3 col-sm-6 mb-3">
                        <h6>ShopVerse Payment Products</h6>
                        <ul class="footer-links list-unstyled">
                            <li><a href="#" class="text-light text-decoration-none">ShopVerse Business Card</a></li>
                            <li><a href="#" class="text-light text-decoration-none">Reload Your Balance</a></li>
                            <li><a href="#" class="text-light text-decoration-none">ShopVerse Currency Converter</a></li>
                        </ul>
                    </div>
                    <div class="col-md-3 col-sm-6 mb-3">
                        <h6>Need Help?</h6>
                        <ul class="footer-links list-unstyled">
                            <li><a href="#" class="text-light text-decoration-none">ShopVerse and COVID-19</a></li>
                            <li><a href="#" class="text-light text-decoration-none">Your Account</a></li>
                            <li><a href="#" class="text-light text-decoration-none">Shipping Rates & Policies</a></li>
                            <li><a href="#" class="text-light text-decoration-none">Returns & Refunds</a></li>
                            <li><a href="#" class="text-light text-decoration-none">Help</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="footer-bottom bg-secondary text-white py-3">
            <div class="container text-center">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <span style="font-weight: bold; font-size: 16px;">shopverse.it</span>
                    </div>
                    <div class="col-md-6">
                        <div class="footer-language">
                            <a href="#" class="text-white me-3 text-decoration-none">
                                <i class="fas fa-globe"></i> English
                            </a>
                            <a href="#" class="text-white text-decoration-none">
                                <i class="fas fa-euro-sign"></i> EUR - Euro
                            </a>
                        </div>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-12">
                        <!-- Copyright and legal information for the site -->
                        <p class="mb-0 small">
                            © 2024 ShopVerse - Advanced E-commerce Platform by Rizzato Sistemas
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/shopverse.js" asp-append-version="true"></script>

    @* ================================================================
       Chat Widget (ShopVerse)
       ================================================================
       This block does two things, in this order (order matters):

       1) Set window.chatWidgetConfig BEFORE the widget script loads below.
          The widget file (chat-widget.min.js) checks for this global
          variable the instant it runs and auto-starts itself if it's
          already set — if the <script src="...chat-widget.min.js"> tag
          came first, the widget would initialize with default config
          instead of ours.

       2) Load the widget script itself from ChatbotService. This is just a
          <script src>, so it is NOT subject to CORS (only fetch/XHR calls
          are) — the browser is allowed to load JS/CSS/images cross-origin,
          it just can't script-read the response of a cross-origin fetch
          without permission. The chat messages themselves ARE fetch calls
          (see chat-widget.min.js -> sendToBackend), which is why
          useBffRouting is true here: they go to GatewayBff
          (bffBaseUrl), and GatewayBff already allows any origin (see
          Program.cs -> AddCors("AllowFrontend") in the GatewayBff project),
          rather than going straight to ChatbotService, whose CORS policy
          only allow-lists the Angular app and GatewayBff itself — not
          ShopVerse's own origin.
    *@
    <script>
        window.chatWidgetConfig = {
            useBffRouting: true,
            bffBaseUrl: '@(Configuration["Services:GatewayBff:BaseUrl"])/api/gateway/chat',
            theme: 'light',
            position: 'bottom-right',
            botName: 'ShopVerse Assistant',
            welcomeMessage: 'Hi! How can I help you on ShopVerse today?'
        };
    </script>
    <script src="@(Configuration["Services:ChatbotService:BaseUrl"])/api/chatwidget/chat-widget.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
