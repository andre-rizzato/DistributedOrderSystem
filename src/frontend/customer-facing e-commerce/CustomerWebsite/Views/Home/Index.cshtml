@{
    // Set the page title for SEO and the browser tab
    ViewData["Title"] = "ShopVerse - Your Trusted E-commerce Platform";
}
@model HomePageViewModel

<div class="homepage-container">
    <!-- Main hero section with a welcome message and an eye-catching call-to-action -->
    <div class="hero-section">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6">
                    <!-- Main title with gradient text and modern design -->
                    <h1 class="display-4 fw-bold mb-4">Welcome to ShopVerse</h1>
                    <!-- Subtitle explaining the platform's advantages -->
                    <p class="lead mb-4">Your personal shopping universe! Thousands of products, fast shipping, unbeatable prices. Discover a new way to shop online!</p>
                    <!-- Call-to-action button to start shopping -->
                    <a href="#featured-products" class="btn btn-light btn-lg">
                        <i class="fas fa-rocket"></i> Explore ShopVerse
                    </a>
                </div>
                <div class="col-lg-6 text-center">
                    <!-- Hero image representing the e-commerce platform -->
                    <img src="https://i0.wp.com/programmaus.unionesarda.it/wp-content/uploads/2024/08/placeholder-2-1.png?ssl=1"
                         alt="ShopVerse - Your e-commerce platform" class="img-fluid rounded" />
                </div>
            </div>
        </div>
    </div>

    <!-- Main centered search bar for an optimal user experience -->
    <div class="main-search-container">
        <div class="search-wrapper">
            <!-- Search form handling categories and search term -->
            <form asp-controller="Home" asp-action="Search" method="get" class="search-form">
                <div class="search-input-group">
                    <!-- Category selector for filtering the search -->
                    <select name="Category" class="category-selector">
                        <option value="">All categories</option>
                        <!-- Categories are loaded dynamically from backend services -->
                        @if(Model?.Categories != null)
                        {
                            @foreach(var category in Model.Categories.Take(10))
                            {
                                <option value="@category.Name">@category.DisplayName</option>
                            }
                        }
                    </select>
                    <!-- Main search input with autocomplete to improve UX -->
                    <input type="text" name="SearchTerm" placeholder="Search ShopVerse - products, brands and more..." class="search-input" autocomplete="off" />
                    <!-- Search button with an intuitive icon -->
                    <button type="submit" class="search-button">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Categories Grid -->
    <section class="py-5">
        <div class="container">
            <div class="row mb-5">
                <div class="col-12 text-center">
                    <h2 class="display-5 fw-bold mb-3">Shop by Category</h2>
                    <p class="lead text-muted">Discover our products organized by category</p>
                </div>
            </div>

            <div class="row g-4">
                <!-- Electronics -->
                <div class="col-lg-3 col-md-6">
                    <a href="/Product/Search?category=electronics" class="category-card text-decoration-none">
                        <div class="text-center">
                            <div class="category-icon">
                                <i class="fas fa-laptop"></i>
                            </div>
                            <h5 class="mt-3 mb-2">Electronics</h5>
                            <p class="text-muted small">Smartphones, computers, TVs</p>
                        </div>
                    </a>
                </div>

                <!-- Fashion -->
                <div class="col-lg-3 col-md-6">
                    <a href="/Product/Search?category=fashion" class="category-card text-decoration-none">
                        <div class="text-center">
                            <div class="category-icon">
                                <i class="fas fa-tshirt"></i>
                            </div>
                            <h5 class="mt-3 mb-2">Fashion</h5>
                            <p class="text-muted small">Clothing, shoes, bags</p>
                        </div>
                    </a>
                </div>

                <!-- Home & Kitchen -->
                <div class="col-lg-3 col-md-6">
                    <a href="/Product/Search?category=home" class="category-card text-decoration-none">
                        <div class="text-center">
                            <div class="category-icon">
                                <i class="fas fa-home"></i>
                            </div>
                            <h5 class="mt-3 mb-2">Home & Kitchen</h5>
                            <p class="text-muted small">Furniture, appliances</p>
                        </div>
                    </a>
                </div>

                <!-- Books -->
                <div class="col-lg-3 col-md-6">
                    <a href="/Product/Search?category=books" class="category-card text-decoration-none">
                        <div class="text-center">
                            <div class="category-icon">
                                <i class="fas fa-book"></i>
                            </div>
                            <h5 class="mt-3 mb-2">Books</h5>
                            <p class="text-muted small">Fiction, non-fiction, guides</p>
                        </div>
                    </a>
                </div>

                <!-- Sports & Leisure -->
                <div class="col-lg-3 col-md-6">
                    <a href="/Product/Search?category=sports" class="category-card text-decoration-none">
                        <div class="text-center">
                            <div class="category-icon">
                                <i class="fas fa-football-ball"></i>
                            </div>
                            <h5 class="mt-3 mb-2">Sports</h5>
                            <p class="text-muted small">Equipment, apparel</p>
                        </div>
                    </a>
                </div>

                <!-- Toys -->
                <div class="col-lg-3 col-md-6">
                    <a href="/Product/Search?category=toys" class="category-card text-decoration-none">
                        <div class="text-center">
                            <div class="category-icon">
                                <i class="fas fa-gamepad"></i>
                            </div>
                            <h5 class="mt-3 mb-2">Toys</h5>
                            <p class="text-muted small">Kids, video games</p>
                        </div>
                    </a>
                </div>

                <!-- Auto & Motorcycle -->
                <div class="col-lg-3 col-md-6">
                    <a href="/Product/Search?category=automotive" class="category-card text-decoration-none">
                        <div class="text-center">
                            <div class="category-icon">
                                <i class="fas fa-car"></i>
                            </div>
                            <h5 class="mt-3 mb-2">Auto & Motorcycle</h5>
                            <p class="text-muted small">Parts, accessories</p>
                        </div>
                    </a>
                </div>

                <!-- Health & Beauty -->
                <div class="col-lg-3 col-md-6">
                    <a href="/Product/Search?category=beauty" class="category-card text-decoration-none">
                        <div class="text-center">
                            <div class="category-icon">
                                <i class="fas fa-heart"></i>
                            </div>
                            <h5 class="mt-3 mb-2">Health & Beauty</h5>
                            <p class="text-muted small">Cosmetics, wellness</p>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Featured Products -->
    <section class="py-5 bg-light" id="featured-products">
        <div class="container">
            <div class="row mb-5">
                <div class="col-12 text-center">
                    <h2 class="display-5 fw-bold mb-3">Featured Products</h2>
                    <p class="lead text-muted">The best products picked for you</p>
                </div>
            </div>

            <div class="row g-4">
                @* Dynamic rendering of products from the database via ViewComponent with a Tag Helper *@
                @{
                    var productsToDisplay = (Model?.FeaturedProducts != null && Model.FeaturedProducts.Any())
                        ? Model.FeaturedProducts
                        : new List<ProductDisplayModel>
                    {
                        new ProductDisplayModel { ProductId = Guid.NewGuid(), Name = "Apple iPhone 15 Pro 128GB", Price = 1229.00m, DiscountPrice = 1044.65m, AverageRating = 5.0, ReviewCount = 1234, QuantityAvailable = 10, IsBestseller = true, FreeShipping = true },
                        new ProductDisplayModel { ProductId = Guid.NewGuid(), Name = "Apple MacBook Air M2 13\"", Price = 1349.00m, AverageRating = 5.0, ReviewCount = 856, QuantityAvailable = 5, FreeShipping = true, IsPrimeEligible = true },
                        new ProductDisplayModel { ProductId = Guid.NewGuid(), Name = "Apple AirPods Pro 2nd gen", Price = 299.00m, DiscountPrice = 239.20m, AverageRating = 4.5, ReviewCount = 2341, QuantityAvailable = 15, FreeShipping = true },
                        new ProductDisplayModel { ProductId = Guid.NewGuid(), Name = "Apple iPad Air 11\" M2", Price = 699.00m, AverageRating = 5.0, ReviewCount = 967, QuantityAvailable = 8, FreeShipping = true },
                        new ProductDisplayModel { ProductId = Guid.NewGuid(), Name = "Apple Watch Series 9 45mm", Price = 459.00m, AverageRating = 5.0, ReviewCount = 1523, QuantityAvailable = 12, FreeShipping = true, IsPrimeEligible = true },
                        new ProductDisplayModel { ProductId = Guid.NewGuid(), Name = "Canon EOS R6 Mark II", Price = 2799.00m, DiscountPrice = 2519.10m, AverageRating = 4.5, ReviewCount = 423, QuantityAvailable = 3, IsBestseller = true },
                        new ProductDisplayModel { ProductId = Guid.NewGuid(), Name = "Sony WH-1000XM5 Wireless", Price = 379.00m, AverageRating = 5.0, ReviewCount = 3421, QuantityAvailable = 20, FreeShipping = true },
                        new ProductDisplayModel { ProductId = Guid.NewGuid(), Name = "Nintendo Switch OLED", Price = 349.99m, DiscountPrice = 262.49m, AverageRating = 5.0, ReviewCount = 5632, QuantityAvailable = 25, FreeShipping = true, IsPrimeEligible = true }
                    };
                }

                @foreach(var product in productsToDisplay)
                {
                    <vc:product-card product="@product"></vc:product-card>
                }

                @if(Model?.FeaturedProducts == null || !Model.FeaturedProducts.Any())
                {
                    @* Note: showing sample products - backend unavailable *@
                }
            </div>
        </div>
    </section>

    <!-- Promotional banner with eye-catching design and effective calls-to-action -->
    <section class="promo-banner">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-8 text-center">
                    <!-- Promotional title with dynamic icon -->
                    <h3><i class="fas fa-bolt"></i> Exclusive ShopVerse Deals</h3>
                    <!-- Benefits description to drive the call to action -->
                    <p class="mb-4">Free shipping on orders over €29 and up to 60% off selected products! Today only!</p>
                    <!-- Call-to-action button linking to special offers -->
                    <a href="/Product/Search?featured=true" class="btn btn-light btn-lg">
                        <i class="fas fa-fire"></i> Discover the Super Deals
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Welcome message shown when the backend services are not running -->
    @if(Model?.FeaturedProducts == null || !Model.FeaturedProducts.Any())
    {
        <div class="welcome-message">
            <!-- Main welcome title -->
            <h2>Welcome to ShopVerse</h2>
            <!-- System status description -->
            <p>The platform is being configured. The backend services are not running yet.</p>
            <!-- Instructions for the system administrator -->
            <p>To use all the advanced features, start the microservices:</p>
            <!-- List of services required for full functionality -->
            <ul>
                <li><strong>ProductService</strong> - Product catalog management</li>
                <li><strong>OrderService</strong> - Order processing</li>
                <li><strong>InventoryService</strong> - Inventory management</li>
                <li><strong>PaymentService</strong> - Payment processing</li>
                <li><strong>NotificationService</strong> - Notification system</li>
                <li><strong>ChatbotService</strong> - AI customer support</li>
            </ul>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Function to add a product to the cart
        function addToCart(productId, quantity = 1) {
            fetch('/Cart/AddItem', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({
                    ProductId: productId,
                    Quantity: quantity
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Update the cart counter
                    updateCartCount(data.cartItemCount);

                    // Show a success message
                    showNotification('Product added to cart!', 'success');
                } else {
                    showNotification(data.message || 'Error adding item to cart', 'error');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showNotification('Error adding item to cart', 'error');
            });
        }

        // Function to update the cart counter
        function updateCartCount(count) {
            const cartCounter = document.querySelector('.cart-count');
            if (cartCounter) {
                cartCounter.textContent = count;
                cartCounter.style.display = count > 0 ? 'inline' : 'none';
            }
        }

        // Function to show notifications
        function showNotification(message, type = 'info') {
            // Simple notification implementation
            const notification = document.createElement('div');
            notification.className = `notification ${type}`;
            notification.textContent = message;
            notification.style.cssText = `
                position: fixed;
                top: 20px;
                right: 20px;
                padding: 15px 25px;
                background-color: ${type === 'success' ? '#4CAF50' : type === 'error' ? '#f44336' : '#2196F3'};
                color: white;
                border-radius: 4px;
                z-index: 10000;
                box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            `;

            document.body.appendChild(notification);

            // Remove after 3 seconds
            setTimeout(() => {
                notification.remove();
            }, 3000);
        }

        // Autocomplete for the search box
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.querySelector('.search-input');
            if (searchInput) {
                let timeout;
                searchInput.addEventListener('input', function() {
                    clearTimeout(timeout);
                    const term = this.value;

                    if (term.length >= 2) {
                        timeout = setTimeout(() => {
                            fetch(`/Home/Autocomplete?term=${encodeURIComponent(term)}`)
                                .then(response => response.json())
                                .then(data => {
                                    // Implement suggestion rendering here
                                    console.log('Suggestions:', data);
                                });
                        }, 300);
                    }
                });
            }
        });
    </script>
}
