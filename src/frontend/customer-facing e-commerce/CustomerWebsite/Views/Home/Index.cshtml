@{
    // Impostazione del titolo della pagina per SEO e browser tab
    ViewData["Title"] = "ShopVerse - La Tua Piattaforma E-commerce di Fiducia";
}
@model HomePageViewModel

<div class="homepage-container">
    <!-- Sezione hero principale con messaggio di benvenuto e call-to-action accattivante -->
    <div class="hero-section">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6">
                    <!-- Titolo principale con gradient text e design moderno -->
                    <h1 class="display-4 fw-bold mb-4">Benvenuto su ShopVerse</h1>
                    <!-- Sottotitolo esplicativo dei vantaggi della piattaforma -->
                    <p class="lead mb-4">Il tuo universo shopping personale! Migliaia di prodotti, spedizione veloce, prezzi imbattibili. Scopri un modo nuovo di fare acquisti online!</p>
                    <!-- Call-to-action button per iniziare lo shopping -->
                    <a href="#featured-products" class="btn btn-light btn-lg">
                        <i class="fas fa-rocket"></i> Esplora ShopVerse
                    </a>
                </div>
                <div class="col-lg-6 text-center">
                    <!-- Immagine hero rappresentativa della piattaforma e-commerce -->
                    <img src="https://i0.wp.com/programmaus.unionesarda.it/wp-content/uploads/2024/08/placeholder-2-1.png?ssl=1" 
                         alt="ShopVerse - La tua piattaforma e-commerce" class="img-fluid rounded" />
                </div>
            </div>
        </div>
    </div>

    <!-- Barra di ricerca principale centralizzata per l'esperienza utente ottimale -->
    <div class="main-search-container">
        <div class="search-wrapper">
            <!-- Form di ricerca con gestione categorie e termine di ricerca -->
            <form asp-controller="Home" asp-action="Search" method="get" class="search-form">
                <div class="search-input-group">
                    <!-- Selettore categoria per filtrare la ricerca -->
                    <select name="Category" class="category-selector">
                        <option value="">Tutte le categorie</option>
                        <!-- Le categorie vengono caricate dinamicamente dai servizi backend -->
                        @if(Model?.Categories != null)
                        {
                            @foreach(var category in Model.Categories.Take(10))
                            {
                                <option value="@category.Name">@category.DisplayName</option>
                            }
                        }
                    </select>
                    <!-- Campo di input principale con autocomplete per migliorare UX -->
                    <input type="text" name="SearchTerm" placeholder="Cerca su ShopVerse - prodotti, marche e molto altro..." class="search-input" autocomplete="off" />
                    <!-- Bottone di ricerca con icona intuitiva -->
                    <button type="submit" class="search-button">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Categories Grid -->
    <section class="py-5">
        <div class="container">
            <div class="row mb-5">
                <div class="col-12 text-center">
                    <h2 class="display-5 fw-bold mb-3">Acquista per categoria</h2>
                    <p class="lead text-muted">Scopri i nostri prodotti organizzati per categoria</p>
                </div>
            </div>
            
            <div class="row g-4">
                <!-- Elettronica -->
                <div class="col-lg-3 col-md-6">
                    <a href="/Product/Search?category=electronics" class="category-card text-decoration-none">
                        <div class="text-center">
                            <div class="category-icon">
                                <i class="fas fa-laptop"></i>
                            </div>
                            <h5 class="mt-3 mb-2">Elettronica</h5>
                            <p class="text-muted small">Smartphone, computer, TV</p>
                        </div>
                    </a>
                </div>
                
                <!-- Moda -->
                <div class="col-lg-3 col-md-6">
                    <a href="/Product/Search?category=fashion" class="category-card text-decoration-none">
                        <div class="text-center">
                            <div class="category-icon">
                                <i class="fas fa-tshirt"></i>
                            </div>
                            <h5 class="mt-3 mb-2">Moda</h5>
                            <p class="text-muted small">Abbigliamento, scarpe, borse</p>
                        </div>
                    </a>
                </div>
                
                <!-- Casa e Cucina -->
                <div class="col-lg-3 col-md-6">
                    <a href="/Product/Search?category=home" class="category-card text-decoration-none">
                        <div class="text-center">
                            <div class="category-icon">
                                <i class="fas fa-home"></i>
                            </div>
                            <h5 class="mt-3 mb-2">Casa e Cucina</h5>
                            <p class="text-muted small">Mobili, elettrodomestici</p>
                        </div>
                    </a>
                </div>
                
                <!-- Libri -->
                <div class="col-lg-3 col-md-6">
                    <a href="/Product/Search?category=books" class="category-card text-decoration-none">
                        <div class="text-center">
                            <div class="category-icon">
                                <i class="fas fa-book"></i>
                            </div>
                            <h5 class="mt-3 mb-2">Libri</h5>
                            <p class="text-muted small">Narrativa, saggistica, guide</p>
                        </div>
                    </a>
                </div>
                
                <!-- Sport e tempo libero -->
                <div class="col-lg-3 col-md-6">
                    <a href="/Product/Search?category=sports" class="category-card text-decoration-none">
                        <div class="text-center">
                            <div class="category-icon">
                                <i class="fas fa-football-ball"></i>
                            </div>
                            <h5 class="mt-3 mb-2">Sport</h5>
                            <p class="text-muted small">Attrezzature, abbigliamento</p>
                        </div>
                    </a>
                </div>
                
                <!-- Giocattoli -->
                <div class="col-lg-3 col-md-6">
                    <a href="/Product/Search?category=toys" class="category-card text-decoration-none">
                        <div class="text-center">
                            <div class="category-icon">
                                <i class="fas fa-gamepad"></i>
                            </div>
                            <h5 class="mt-3 mb-2">Giocattoli</h5>
                            <p class="text-muted small">Bambini, videogames</p>
                        </div>
                    </a>
                </div>
                
                <!-- Auto e Moto -->
                <div class="col-lg-3 col-md-6">
                    <a href="/Product/Search?category=automotive" class="category-card text-decoration-none">
                        <div class="text-center">
                            <div class="category-icon">
                                <i class="fas fa-car"></i>
                            </div>
                            <h5 class="mt-3 mb-2">Auto e Moto</h5>
                            <p class="text-muted small">Ricambi, accessori</p>
                        </div>
                    </a>
                </div>
                
                <!-- Salute e Bellezza -->
                <div class="col-lg-3 col-md-6">
                    <a href="/Product/Search?category=beauty" class="category-card text-decoration-none">
                        <div class="text-center">
                            <div class="category-icon">
                                <i class="fas fa-heart"></i>
                            </div>
                            <h5 class="mt-3 mb-2">Salute e Bellezza</h5>
                            <p class="text-muted small">Cosmetici, benessere</p>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Featured Products -->
    <section class="py-5 bg-light" id="featured-products">
        <div class="container">
            <div class="row mb-5">
                <div class="col-12 text-center">
                    <h2 class="display-5 fw-bold mb-3">Prodotti in evidenza</h2>
                    <p class="lead text-muted">I migliori prodotti selezionati per te</p>
                </div>
            </div>
            
            <div class="row g-4">
                @* Rendering dinamico dei prodotti dal database usando ViewComponent con Tag Helper *@
                @{
                    var productsToDisplay = (Model?.FeaturedProducts != null && Model.FeaturedProducts.Any()) 
                        ? Model.FeaturedProducts 
                        : new List<ProductDisplayModel>
                    {
                        new ProductDisplayModel { ProductId = Guid.NewGuid(), Name = "Apple iPhone 15 Pro 128GB", Price = 1229.00m, DiscountPrice = 1044.65m, AverageRating = 5.0, ReviewCount = 1234, QuantityAvailable = 10, IsBestseller = true, FreeShipping = true },
                        new ProductDisplayModel { ProductId = Guid.NewGuid(), Name = "Apple MacBook Air M2 13\"", Price = 1349.00m, AverageRating = 5.0, ReviewCount = 856, QuantityAvailable = 5, FreeShipping = true, IsPrimeEligible = true },
                        new ProductDisplayModel { ProductId = Guid.NewGuid(), Name = "Apple AirPods Pro 2ª gen", Price = 299.00m, DiscountPrice = 239.20m, AverageRating = 4.5, ReviewCount = 2341, QuantityAvailable = 15, FreeShipping = true },
                        new ProductDisplayModel { ProductId = Guid.NewGuid(), Name = "Apple iPad Air 11\" M2", Price = 699.00m, AverageRating = 5.0, ReviewCount = 967, QuantityAvailable = 8, FreeShipping = true },
                        new ProductDisplayModel { ProductId = Guid.NewGuid(), Name = "Apple Watch Series 9 45mm", Price = 459.00m, AverageRating = 5.0, ReviewCount = 1523, QuantityAvailable = 12, FreeShipping = true, IsPrimeEligible = true },
                        new ProductDisplayModel { ProductId = Guid.NewGuid(), Name = "Canon EOS R6 Mark II", Price = 2799.00m, DiscountPrice = 2519.10m, AverageRating = 4.5, ReviewCount = 423, QuantityAvailable = 3, IsBestseller = true },
                        new ProductDisplayModel { ProductId = Guid.NewGuid(), Name = "Sony WH-1000XM5 Wireless", Price = 379.00m, AverageRating = 5.0, ReviewCount = 3421, QuantityAvailable = 20, FreeShipping = true },
                        new ProductDisplayModel { ProductId = Guid.NewGuid(), Name = "Nintendo Switch OLED", Price = 349.99m, DiscountPrice = 262.49m, AverageRating = 5.0, ReviewCount = 5632, QuantityAvailable = 25, FreeShipping = true, IsPrimeEligible = true }
                    };
                }
                
                @foreach(var product in productsToDisplay)
                {
                    <vc:product-card product="@product"></vc:product-card>
                }
                
                @if(Model?.FeaturedProducts == null || !Model.FeaturedProducts.Any())
                {
                    @* Nota: Visualizzazione prodotti di esempio - backend non disponibile *@
                }
            </div>
        </div>
    </section>

    <!-- Banner promozionale con design accattivante e call-to-action efficaci -->
    <section class="promo-banner">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-8 text-center">
                    <!-- Titolo promozionale con icona dinamica -->
                    <h3><i class="fas fa-bolt"></i> Offerte Esclusive ShopVerse</h3>
                    <!-- Descrizione dei benefici per incentivare l'azione -->
                    <p class="mb-4">Spedizione gratuita sopra i 29€ e fino al 60% di sconto sui prodotti selezionati! Solo per oggi!</p>
                    <!-- Button call-to-action con link alle offerte speciali -->
                    <a href="/Product/Search?featured=true" class="btn btn-light btn-lg">
                        <i class="fas fa-fire"></i> Scopri le Super Offerte
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Messaggio di benvenuto quando i servizi backend non sono attivi -->
    @if(Model?.FeaturedProducts == null || !Model.FeaturedProducts.Any())
    {
        <div class="welcome-message">
            <!-- Titolo di benvenuto principale -->
            <h2>Benvenuto su ShopVerse</h2>
            <!-- Descrizione dello stato del sistema -->
            <p>La piattaforma è in fase di configurazione. I servizi backend non sono ancora attivi.</p>
            <!-- Istruzioni per l'amministratore del sistema -->
            <p>Per utilizzare tutte le funzionalità avanzate, avvia i microservizi:</p>
            <!-- Lista dei servizi necessari per il funzionamento completo -->
            <ul>
                <li><strong>ProductService</strong> - Gestione catalogo prodotti</li>
                <li><strong>OrderService</strong> - Elaborazione ordini</li>
                <li><strong>InventoryService</strong> - Gestione inventario</li>
                <li><strong>PaymentService</strong> - Processamento pagamenti</li>
                <li><strong>NotificationService</strong> - Sistema notifiche</li>
                <li><strong>ChatbotService</strong> - Assistenza clienti AI</li>
            </ul>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Funzione per aggiungere prodotto al carrello
        function addToCart(productId, quantity = 1) {
            fetch('/Cart/AddItem', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({
                    ProductId: productId,
                    Quantity: quantity
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Aggiorna il contatore del carrello
                    updateCartCount(data.cartItemCount);
                    
                    // Mostra messaggio di successo
                    showNotification('Prodotto aggiunto al carrello!', 'success');
                } else {
                    showNotification(data.message || 'Errore durante l\'aggiunta al carrello', 'error');
                }
            })
            .catch(error => {
                console.error('Errore:', error);
                showNotification('Errore durante l\'aggiunta al carrello', 'error');
            });
        }

        // Funzione per aggiornare il contatore del carrello
        function updateCartCount(count) {
            const cartCounter = document.querySelector('.cart-count');
            if (cartCounter) {
                cartCounter.textContent = count;
                cartCounter.style.display = count > 0 ? 'inline' : 'none';
            }
        }

        // Funzione per mostrare notifiche
        function showNotification(message, type = 'info') {
            // Implementazione semplice di notifica
            const notification = document.createElement('div');
            notification.className = `notification ${type}`;
            notification.textContent = message;
            notification.style.cssText = `
                position: fixed;
                top: 20px;
                right: 20px;
                padding: 15px 25px;
                background-color: ${type === 'success' ? '#4CAF50' : type === 'error' ? '#f44336' : '#2196F3'};
                color: white;
                border-radius: 4px;
                z-index: 10000;
                box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            `;
            
            document.body.appendChild(notification);
            
            // Rimuovi dopo 3 secondi
            setTimeout(() => {
                notification.remove();
            }, 3000);
        }

        // Autocomplete per la ricerca
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.querySelector('.search-input');
            if (searchInput) {
                let timeout;
                searchInput.addEventListener('input', function() {
                    clearTimeout(timeout);
                    const term = this.value;
                    
                    if (term.length >= 2) {
                        timeout = setTimeout(() => {
                            fetch(`/Home/Autocomplete?term=${encodeURIComponent(term)}`)
                                .then(response => response.json())
                                .then(data => {
                                    // Implementa qui la logica per mostrare i suggerimenti
                                    console.log('Suggerimenti:', data);
                                });
                        }, 300);
                    }
                });
            }
        });
    </script>
}
