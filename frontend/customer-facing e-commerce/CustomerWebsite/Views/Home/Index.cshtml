@section Scripts {
    <script>
        // Funzione per aggiungere prodotto al carrello
        function addToCart(productId, quantity = 1) {
            fetch('/Cart/AddItem', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({
                    ProductId: productId,
                    Quantity: quantity
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Aggiorna il contatore del carrello
                    updateCartCount(data.cartItemCount);
                    
                    // Mostra messaggio di successo
                    showNotification('Prodotto aggiunto al carrello!', 'success');
                } else {
                    showNotification(data.message || 'Errore durante l\'aggiunta al carrello', 'error');
                }
            })
            .catch(error => {
                console.error('Errore:', error);
                showNotification('Errore durante l\'aggiunta al carrello', 'error');
            });
        }

        // Funzione per aggiornare il contatore del carrello
        function updateCartCount(count) {
            const cartCounter = document.querySelector('.cart-count');
            if (cartCounter) {
                cartCounter.textContent = count;
                cartCounter.style.display = count > 0 ? 'inline' : 'none';
            }
        }

        // Funzione per mostrare notifiche
        function showNotification(message, type = 'info') {
            // Implementazione semplice di notifica
            const notification = document.createElement('div');
            notification.className = `notification ${type}`;
            notification.textContent = message;
            notification.style.cssText = `
                position: fixed;
                top: 20px;
                right: 20px;
                padding: 15px 25px;
                background-color: ${type === 'success' ? '#4CAF50' : type === 'error' ? '#f44336' : '#2196F3'};
                color: white;
                border-radius: 4px;
                z-index: 10000;
                box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            `;
            
            document.body.appendChild(notification);
            
            // Rimuovi dopo 3 secondi
            setTimeout(() => {
                notification.remove();
            }, 3000);
        }

        // Autocomplete per la ricerca
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.querySelector('.search-input');
            if (searchInput) {
                let timeout;
                searchInput.addEventListener('input', function() {
                    clearTimeout(timeout);
                    const term = this.value;
                    
                    if (term.length >= 2) {
                        timeout = setTimeout(() => {
                            fetch(`/Home/Autocomplete?term=${encodeURIComponent(term)}`)
                                .then(response => response.json())
                                .then(data => {
                                    // Implementa qui la logica per mostrare i suggerimenti
                                    console.log('Suggerimenti:', data);
                                });
                        }, 300);
                    }
                });
            }
        });
    </script>
}
